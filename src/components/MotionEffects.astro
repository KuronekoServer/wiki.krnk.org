<script>
  import { animate } from 'framer-motion/dom/mini';

  let cleanups: Array<() => void> = [];
  let isInitialPage = true;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const animations = new Set<ReturnType<typeof animate>>();

  const playAnimation: typeof animate = (...args) => {
    const animation = animate(...args);
    animations.add(animation);
    animation.then(() => animations.delete(animation));
    return animation;
  };

  const clearMotion = () => {
    for (const cleanup of cleanups) cleanup();
    cleanups = [];
    // Finish active effects so interrupted navigation or a preference change
    // cannot leave content at a partially transparent keyframe.
    for (const animation of animations) animation.complete();
    animations.clear();
  };

  const setupMotion = () => {
    const page = document.querySelector<HTMLElement>('main[data-pagefind-body]');
    if (!page || page.dataset.motionReady === 'true') return;

    clearMotion();
    page.dataset.motionReady = 'true';

    if (reducedMotion.matches) return;

    const animateInitialPage = isInitialPage;
    isInitialPage = false;

    const content = page.querySelector<HTMLElement>('.sl-markdown-content');
    if (content) {
      const intro = Array.from(content.children)
        .filter((element): element is HTMLElement => element instanceof HTMLElement)
        .slice(0, 5);

      if (animateInitialPage) {
        for (const [index, element] of intro.entries()) {
          playAnimation(
            element,
            {
              opacity: [0, 1],
              transform: ['translateY(10px)', 'translateY(0px)'],
            },
            {
              duration: 0.42,
              delay: index * 0.045,
              ease: [0.22, 1, 0.36, 1],
            },
          );
        }
      } else {
        playAnimation(
          content,
          { transform: ['translateY(5px)', 'translateY(0px)'] },
          { duration: 0.26, ease: [0.22, 1, 0.36, 1] },
        );
      }

      const introElements = new Set(intro);
      const revealTargets = content.querySelectorAll<HTMLElement>(
        ':scope > h2, :scope > h3, :scope > .starlight-aside, :scope > .card-grid, :scope > table, :scope > pre, :scope > figure, :scope > img',
      );

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;

              const target = entry.target as HTMLElement;
              observer.unobserve(target);
              playAnimation(
                target,
                {
                  opacity: [0, 1],
                  transform: ['translateY(12px)', 'translateY(0px)'],
                },
                { duration: 0.46, ease: [0.22, 1, 0.36, 1] },
              );
            }
          },
          // Long tables can never reach a percentage-based threshold. Animate
          // as soon as any part enters the viewport, keeping the base visible.
          { threshold: 0 },
        );

        for (const target of revealTargets) {
          if (introElements.has(target)) continue;

          observer.observe(target);
        }

        cleanups.push(() => observer.disconnect());
      } else {
        for (const target of revealTargets) {
          if (introElements.has(target)) continue;

          playAnimation(
            target,
            {
              opacity: [0, 1],
              transform: ['translateY(12px)', 'translateY(0px)'],
            },
            { duration: 0.46, ease: [0.22, 1, 0.36, 1] },
          );
        }
      }
    }

    if (animateInitialPage) {
      const sidebarParts = document.querySelectorAll<HTMLElement>(
        '.sidebar-utility, .sidebar-navigation, .sidebar-preferences',
      );
      for (const [index, element] of sidebarParts.entries()) {
        playAnimation(
          element,
          {
            opacity: [0, 1],
            transform: ['translateX(-8px)', 'translateX(0px)'],
          },
          {
            duration: 0.36,
            delay: index * 0.055,
            ease: [0.22, 1, 0.36, 1],
          },
        );
      }
    }

    const interactiveCards = document.querySelectorAll<HTMLElement>(
      '.card, .pagination-links a',
    );
    for (const card of interactiveCards) {
      const originalTransform = card.style.transform;
      let hoverAnimation: ReturnType<typeof animate> | undefined;
      const lift = () => {
        hoverAnimation = animate(
          card,
          { transform: 'translateY(-3px)' },
          { duration: 0.18, ease: 'easeOut' },
        );
      };
      const reset = () => {
        hoverAnimation = animate(
          card,
          { transform: 'translateY(0px)' },
          { duration: 0.22, ease: 'easeOut' },
        );
      };

      card.addEventListener('pointerenter', lift);
      card.addEventListener('pointerleave', reset);
      card.addEventListener('focusin', lift);
      card.addEventListener('focusout', reset);

      cleanups.push(() => {
        hoverAnimation?.cancel();
        card.style.transform = originalTransform;
        card.removeEventListener('pointerenter', lift);
        card.removeEventListener('pointerleave', reset);
        card.removeEventListener('focusin', lift);
        card.removeEventListener('focusout', reset);
      });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMotion, { once: true });
  } else {
    setupMotion();
  }

  document.addEventListener('astro:page-load', setupMotion);
  document.addEventListener('astro:before-swap', clearMotion);
  reducedMotion.addEventListener('change', () => {
    clearMotion();
    const page = document.querySelector<HTMLElement>('main[data-pagefind-body]');
    if (page) delete page.dataset.motionReady;
    setupMotion();
  });
</script>
