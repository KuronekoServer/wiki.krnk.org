---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
---

<div class="sidebar-utility">
  <div class="sidebar-brand sl-hidden md:sl-flex">
    <SiteTitle />
  </div>
  <div class="sidebar-search">
    <Search />
  </div>
</div>

<div class="sidebar-navigation">
  <Default />
</div>

<div class="sidebar-preferences sl-hidden md:sl-flex">
  <ThemeSelect />
  <LanguageSelect />
</div>

<style>
  .sidebar-utility {
    display: grid;
    gap: 0.75rem;
    margin: -1rem calc(-1 * var(--sl-sidebar-pad-x)) 0;
    padding: 0.85rem var(--sl-sidebar-pad-x) 1rem;
    border-bottom: 1px solid var(--docs-border);
  }

  .sidebar-brand {
    align-items: center;
    min-height: 2.4rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--docs-border);
  }

  .sidebar-navigation {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
  }


  .sidebar-preferences {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-inline: calc(-1 * var(--sl-sidebar-pad-x));
    padding: 0.6rem var(--sl-sidebar-pad-x);
    border-top: 1px solid var(--docs-border);
    background: var(--sl-color-bg-sidebar);
  }
</style>
